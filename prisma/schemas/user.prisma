model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  phone String?
  name  String?
  passwordHash String
  role UserRole @default(CUSTOMER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

enum UserRole {
  ADMIN
  CUSTOMER
}
