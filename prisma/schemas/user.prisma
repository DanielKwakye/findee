model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String @unique
  phone String?
  name  String?
  passwordHash String?
  mustChangePassword Boolean @default(false)
  otp String?
  otpCreatedAt DateTime?
  role UserRole @default(CUSTOMER)
  closedAt DateTime?
  deactivatedAt DateTime?
  lastPortalVisitedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  reservedProducts Product[] @relation("ProductReservation")
  assignedProducts Product[] @relation("ProductAssignment")
  orders Order[]
  tickets Ticket[]
}

enum UserRole {
  ADMIN
  CUSTOMER
}
