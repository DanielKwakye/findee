model Order {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  number               String               @unique
  customerId           String               @db.ObjectId
  customer             User                 @relation(fields: [customerId], references: [id])
  status               OrderStatus          @default(PENDING)
  planDetail           PlanDetail
  products             Product[]
  defaultReachoutModes  ReachoutModes
  showOwnerName        Boolean              @default(false)
  shippingAddress      String?
  deliveryInstructions String?
  shipments            Shipment[]
  cancelledAt          DateTime?
  cancellationReason   String?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

type PlanDetail {
  plan                OrderPlan
  quantity            Int
  price               Float
  currency            String
  /// Maximum distinct users assigned to products in this order.
  maxRecoveryProfiles Int?
  allocations         PlanVariantAllocation[]
}

type PlanVariantAllocation {
  variant  String
  quantity Int
}

type ReachoutModes {
  phone Boolean @default(false)
  email Boolean @default(false)
  chat  Boolean @default(false)
}


enum OrderPlan {
  Starter
  Pro
  Premium
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}
