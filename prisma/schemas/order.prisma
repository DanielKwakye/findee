model Order {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  number               String               @unique
  customerId           String               @db.ObjectId
  customer             User                 @relation(fields: [customerId], references: [id])
  status               OrderStatus          @default(PENDING)
  plan                 OrderPlan
  planDetail           PlanDetail
  products             Product[]
  defaultReachoutModes  ReachoutModes
  shippingAddress      ShippingAddress
  deliveryInstructions String?
  shipments            Shipment[]
  cancelledAt          DateTime?
  cancellationReason   String?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

type PlanDetail {
  quantity               Int
  /// Maximum distinct users assigned to products in this order.
  maxRecoveryProfiles    Int
  pricePerEverydayVariant Float
  pricePerFabricVariant   Float
  pricePerToughVariant    Float
}

type ReachoutModes {
  phone Boolean @default(false)
  email Boolean @default(false)
  chat  Boolean @default(false)
}

type ShippingAddress {
  recipientName String
  email         String?
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  region        String?
  postalCode    String?
  countryCode   String
}

enum OrderPlan {
  Starter
  Pro
  Premium
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}
